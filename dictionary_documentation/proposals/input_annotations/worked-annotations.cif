data_worked_annotations
# Proposed compact ModelCIF annotation categories, not released items.
# Illustrative fragment; not a complete deposition or executed workflow.
# Existing fields use ModelCIF 1.4.9. Output structures are not included.
# State defaults to specified for the populated rows below.
# Dictionary-defined point3 means x/y/z; no per-file shape table is needed.

# BEGIN workflow
loop_
_ma_data.id
_ma_data.name
_ma_data.content_type
_ma_data.content_type_other_details
1 'Reference coordinates' 'input structure' .
2 'Authored design conditions' other 'Annotation set'
3 'Designed backbone' 'intermediate backbone' .
4 'Designed sequence' 'intermediate sequence' .
5 'Predicted validation model' 'model coordinates' .
loop_
_ma_data_group.ordinal_id
_ma_data_group.group_id
_ma_data_group.data_id
