  },
  "generic_api_requirements": [
    {
      "concept": "definition identity and extension registry",
      "target": "Stable identifier/namespace/version, scientific definition, registered shared terms and custom terms; no executable code loading."
    },
    {
      "concept": "semantic level",
      "required_values": [
        "atom",
        "token",
        "residue",
        "chain",
        "molecule",
        "system"
      ],
      "target": "Semantic subjects separate from feature selection; explicit membership/context/order where needed."
    },
    {
      "concept": "body order",
      "required_values": [
        0,
        1,
        2
      ],
      "target": "Ordered operands, with zero-body set/system context and explicit pair symmetry; group size independent of body order."
    },
    {
      "concept": "scalar type and categorical domain",
      "required_values": [
        "boolean",
        "integer",
        "real",
        "text",
        "component"
      ],
      "target": "Defined portable scalar domains and symbolic/code meanings; reject unsupported dtypes explicitly rather than silently coercing."
    },
    {
      "concept": "value shape",
      "target": "Declared rank, dimension lengths, axis order/labels, element indexing and state; support general declared shapes within explicit profile/resource limits."
    },
    {
      "concept": "defaults and masks",
      "target": "Definition-specific inactive/unknown/not-applicable/explicit states; scalar and per-element defaults; materialize structure-dependent default functions as effective values with provenance."
    },
    {
      "concept": "broadcasting and sparse pairs",
      "target": "Validate level consistency before collapse; preserve sparse storage and omitted-value rules; no forced dense pair matrices."
    },
    {
      "concept": "coordinates and transformations",
      "target": "Frame/scoped membership, point versus vector transformation rule, explicit revalidation after membership change."
    },
    {
      "concept": "index and future topology",
      "target": "Logical positions/segments, order, bounds, anchors, relative offsets, context and later realization mappings without fake atoms."
    },
    {
      "concept": "metadata lifecycle",
      "target": "Retain definitions/provenance alongside arrays; copy/slice/concatenate/assembly/edit remap or explicitly invalidate references."
    },
    {
      "concept": "custom definitions and unknown content",
      "target": "Same generic representation and types; distinguish retention from semantic execution support; reject unsupported required conditions."
    },
    {
      "concept": "file migration",
      "target": "One canonical ModelCIF representation. A versioned converter may rewrite historical files; permanent legacy reading and byte/name/layout compatibility are not requirements."
    }
  ],
  "mapping_families": {
    "design_segment": {
      "target": "Logical design segment with minimum/maximum realized length, context, anchors/order and later realization correspondence.",
      "requirements": [
        "Replace placeholder-residue sentinel encoding with declared logical subjects.",
        "Preserve zero-length bounds; -1 means this annotation is inactive, not a negative segment length.",
        "Specify joint-bound validity, ordering and realization provenance."
      ]
    },
    "tokenization": {
      "target": "Tokenization definition/version and resulting explicit membership, plus an atomistic treatment request where necessary.",
      "requirements": [
        "Materialize structure-dependent defaults.",
        "Distinguish an authored request from the tokenization actually consumed.",
        "Retain atom-level source semantics; a boolean alone is not a portable tokenizer."
      ]
    },
    "sequence_identity": {
      "target": "Component identity assignment on a residue or logical position.",
      "requirements": [
        "Map <M> to explicit condition state.",
        "Reference unambiguous canonical or custom component definitions.",
        "Specify precedence relative to partial sequence probabilities and effective inferred identities."
      ]
    },
    "coordinate_target": {
      "target": "Point target, explicit coordinate frame and scoped rigid-group membership.",
      "requirements": [
        "Distinguish absolute model placement from independent rigid placement.",
        "InternalCoordinate is group-local Cartesian geometry, not bond/angle/torsion coordinates.",
        "Replace reserved -1/0/positive group conventions with explicit states/frame kind.",
        "Resolve partial-component coordinate acceptance explicitly; current code paths differ.",
        "Keep coordinate presence and group membership consistent."
      ]
    },
    "index_relation": {
      "target": "Indexed-status definition and contextual token membership, ordered groups and explicit relative offsets.",
      "requirements": [
        "C_IDX defaults to true; materialize or define that default.",
        "Record molecule instance context and unindexed insertion relations, not just group integers.",
        "Preserve any known offsets and distinguish unknown inter-group distances."
      ]
    },
    "distance_restraint": {
      "target": "Existing ModelCIF distance restraints where endpoint and scientific semantics match, with annotation state/purpose links as required.",
      "requirements": [
        "Do not introduce a competing distance category for already representable semantics.",
        "Specify units, target/tolerance or bounds and symmetric endpoint interpretation.",
        "The source mask uses distance > 0; do not invent a requested zero-distance constraint from inactive storage."
      ]
    },
    "terminus": {
      "target": "Typed terminal-position condition on structural/logical residues, linked to chain topology.",
      "requirements": [
        "Materialize structural defaults and account for non-polymers.",
        "Define false/inactive behavior using each consumer, not a generic boolean rule.",
        "Validate against future topology and realized chain boundaries."
      ]
    },
    "chain_relation": {
      "target": "Symmetric pair relation between chain subjects with explicit instance membership.",
      "requirements": [
        "Validate consistency before collapsing atom-broadcast pair storage.",
        "Specify default same-chain relation and omitted-pair semantics.",
        "Keep chain and molecule instance/group identity distinct."
      ]
    },
    "interaction_request": {
      "target": "Typed atom-level condition with a versioned categorical/boolean domain and partner/context references.",
      "requirements": [
        "Do not infer observed interaction from a request.",
        "Hotspot false means no hotspot request, not a requested anti-hotspot.",
        "Publish donor/acceptor, charge, aromatic and metal-role meanings as applicable.",
        "Specify partner/context and operational definitions separately from training-time label-generation recipes."
      ]
    },
    "rasa": {
      "target": "Atom-level categorical solvent-accessibility condition with versioned bin semantics.",
      "requirements": [
        "Specify radii, normalization, probe, algorithm, boundary convention and source provenance.",
        "Map UNSPECIFIED to explicit state without interpreting its integer code as a measurement."
      ]
    },
    "secondary_structure": {
      "target": "Residue-level categorical secondary-structure condition.",
      "requirements": [
        "Version the symbolic domain and assignment convention.",
        "Distinguish condition, prepared label and evaluated result.",
        "Map NONE to its actual inactive meaning."
      ]
    },
    "cath": {
      "target": "Residue-level classification term and vocabulary release/source.",
      "requirements": [
        "Define CATH label granularity and source release.",
        "Preserve null/unassigned state and residue coverage without relying on fixed text width."
      ]
    },
    "centroid": {
      "target": "Explicitly defined centroid target with point shape, frame and selected contributing atoms.",
      "requirements": [
        "Source annotation level is atom, despite its class name; do not silently relabel it chain-level.",
        "Resolve unweighted coordinate-mean implementation versus center-of-mass wording.",
        "Define aggregation, membership and broadcasting before registering the shared term."
      ]
    },
    "base_pair": {
      "target": "Pairwise residue relation with a versioned base-pair domain and symmetry rule.",
      "requirements": [
        "Publish meanings of non-pair and unspecified states separately.",
        "Validate endpoint consistency and sparse omitted-value semantics.",
        "Use structural or logical residue subjects as appropriate."
      ]
    },
    "nucleic_state": {
      "target": "One-residue nucleic structural-state condition with a versioned domain.",
      "requirements": [
        "Its use of BasePairEnum does not turn it into a two-body relation.",
        "Clarify per-residue interpretation and relation to pairwise base-pair assignments."
      ]
    },
    "correspondence": {
      "target": "Data/artifact-scoped correspondence and derivation records, with descriptive source labels retained when useful.",
      "requirements": [
        "Do not infer globally unique subjects from short local strings or -1 sentinels.",
        "Represent generated/deleted subjects, assembly copies and insertion mapping explicitly.",
        "If the old file lacks sufficient source identity, preserve the label and report unresolved correspondence.",
        "These annotations can occur on derived/output data; an input-only namespace is insufficient."
      ]
    },
    "reference_geometry": {
      "target": "Derived reference point values with frame, structural correspondence and producing protocol.",
      "requirements": [
        "This is reference geometry, not itself a QA score.",
        "Preserve point transformation and insertion correspondence.",
        "Store downstream computed QA in existing ModelCIF result categories."
      ]
    },
    "sequence_probability": {
      "target": "Component-labelled elements of a residue-level sequence-probability assignment, with per-component states.",
      "requirements": [
        "Map each source probability class to its explicit chemical component, without private channel indices.",
        "Zero excludes the component; NaN is unspecified in the source.",
        "Define remaining mass, normalization and exact-identity precedence, including noncanonical identities.",
        "The 28 built-in channels are not a universal chemical vocabulary; the representation must admit other components.",
        "Choose one authoritative standardized layout; source scalar accessors may map to elements of a shaped value."
      ]
    }
  },
